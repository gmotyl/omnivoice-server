#!/usr/bin/env bash
# Manage the local OmniVoice TTS server (OpenAI-compatible, 127.0.0.1:8890) and its browser
# relay (relay/, anytts relay protocol with an origin allowlist, 127.0.0.1:8891), plus the
# Narrate / Read Aloud adapter (narrate/, in front of the relay, 127.0.0.1:8892).
# Usage: omnivoicectl start|stop|restart|status|log|relay-log|narrate-log
# Safe to call from the WSL [boot] command: it sets its own PATH/HOME and never blocks.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PIDFILE="$DIR/run/omnivoice.pid"
LOG="$DIR/logs/server.log"
RELAY_PIDFILE="$DIR/run/relay.pid"
RELAY_LOG="$DIR/logs/relay.log"
NARRATE_PIDFILE="$DIR/run/narrate.pid"
NARRATE_LOG="$DIR/logs/narrate.log"

# The caller's PATH, before it is pinned below: the node the caller would run (fnm, nvm) is on
# it, while the pinned system dirs may hold an older one.
CALLER_PATH="${PATH:-}"

# The boot command runs with a near-empty environment; pin everything the server needs.
# No HOME (the WSL [boot] command): take the invoking user's home from passwd.
if [[ -z "${HOME:-}" ]]; then
  HOME="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6 || true)"
  export HOME="${HOME:-/root}"
fi
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# Optional, gitignored $DIR/relay.env: KEY=VALUE lines (blank lines and # comments skipped,
# one pair of surrounding quotes stripped) for the relay and this ctl, so RELAY_ALLOWED_ORIGINS
# etc. apply however the ctl is called (the Pavilio panel and the WSL boot command source no
# secrets). Parsed, never executed. A variable already in the environment wins over the file.
RELAY_ENV_FILE="$DIR/relay.env"
RELAY_ENV_LOADED=()
load_relay_env() {
  local line key value
  [[ -f "$RELAY_ENV_FILE" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ ! "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      echo "relay.env: skipped a line that is not KEY=VALUE" >&2
      continue
    fi
    key="${BASH_REMATCH[2]}"
    value="${BASH_REMATCH[3]}"
    if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then value="${BASH_REMATCH[1]}"; fi
    [[ -n "${!key+x}" ]] && continue
    export "$key=$value"
    RELAY_ENV_LOADED+=("$key")
  done <"$RELAY_ENV_FILE"
}
load_relay_env

# Defaults applied after relay.env, so the file can set them (the calling environment still wins).
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
# Model is cached; don't let a boot without network block on a hub lookup.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

PORT="${OMNIVOICE_PORT:-8890}"
RELAY_PORT="${RELAY_PORT:-8891}"
RELAY_HOST="${RELAY_HOST:-127.0.0.1}"
RELAY_SERVE_HTTPS_PORT="${RELAY_SERVE_HTTPS_PORT:-8443}"
RELAY_MIN_NODE=22
NARRATE_PORT="${NARRATE_PORT:-8892}"
NARRATE_HOST="${NARRATE_HOST:-127.0.0.1}"
NARRATE_SERVE_HTTPS_PORT="${NARRATE_SERVE_HTTPS_PORT:-8444}"

# ours <pid> <script> <cwd>: the pid is a live process running <script> from <cwd> (the ctl
# starts the server from $DIR and the relay from $DIR/relay). One argv entry must name exactly
# this checkout's script: <script> or ./<script> (relative to <cwd>) or <cwd>/<script>. A same
# basename elsewhere (/tmp/server.py), a reused pid or a sibling clone's process is not ours and
# is never signalled.
ours() {
  local pid="$1" script="$2" cwd="$3" arg match=
  local -a argv=()
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" == "$cwd" ]] || return 1
  mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 1
  for arg in "${argv[@]}"; do
    case "$arg" in
      "$script" | "./$script" | "$cwd/$script") match=1; break ;;
    esac
  done
  [[ -n "$match" ]]
}

# alive <pidfile> <script> <cwd>: the pid file names a process of ours. A pid file that names
# anything else is stale and removed.
alive() {
  local pidfile="$1" pid
  [[ -f "$pidfile" ]] || return 1
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if ours "$pid" "$2" "$3"; then return 0; fi
  rm -f "$pidfile"
  echo "$(basename "$pidfile"): stale (pid ${pid:-?} is not this ctl's $2), removed" >&2
  return 1
}

pid_alive() { alive "$PIDFILE" server.py "$DIR"; }

# node_orphans <subdir>: node processes of this DIR (server.mjs run from $DIR/<subdir>) that run
# without (or with a stale) pid file, e.g. after run/ was wiped.
node_orphans() {
  local p pid
  for p in /proc/[0-9]*; do
    pid="${p#/proc/}"
    ours "$pid" server.mjs "$DIR/$1" && printf '%s\n' "$pid"
  done
  return 0
}

http_ok() { # http_ok <url>: 0 when the URL answers 2xx within 2 s
  python3 - "$1" <<'PY' 2>/dev/null
import sys, urllib.request
urllib.request.urlopen(sys.argv[1], timeout=2).read()
PY
}

health() { http_ok "http://127.0.0.1:$PORT/health"; }

kill_ours() { # kill_ours <pid> <script> <cwd>: TERM, up to 10 s, then KILL; only while ours
  local pid="$1"
  ours "$@" || return 0
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    ours "$@" || return 0
    sleep 0.2
  done
  if ours "$@"; then kill -9 "$pid" 2>/dev/null || true; fi
}

stop_server() {
  local pid
  if ! pid_alive; then
    echo "server: not running"
    return 0
  fi
  pid="$(cat "$PIDFILE")"
  kill_ours "$pid" server.py "$DIR"
  rm -f "$PIDFILE"
  echo "server: stopped (pid $pid)"
}

# --- server -----------------------------------------------------------------------------------

start_server() {
  if pid_alive; then
    echo "server: already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  # Something else (another clone, a hand-started server) already serves this port: a second
  # GPU process would only fail to bind after loading the model, so leave it be.
  if health; then
    echo "server: already answering on 127.0.0.1:$PORT (not started by this ctl), not starting another"
    return 0
  fi
  mkdir -p "$DIR/run" "$DIR/logs"
  cd "$DIR"
  # Detach fully so the caller (boot command, terminal) can exit.
  setsid nohup "$DIR/.venv/bin/python" -W ignore server.py >>"$LOG" 2>&1 </dev/null &
  echo $! >"$PIDFILE"
  echo "server: started (pid $!), log: $LOG"
}

server_status() {
  if pid_alive; then
    if health; then
      echo "server: running (pid $(cat "$PIDFILE")), healthy on 127.0.0.1:$PORT"
    else
      echo "server: running (pid $(cat "$PIDFILE")), not answering /health yet (model loading?)"
      return 1
    fi
  elif health; then
    echo "server: healthy on 127.0.0.1:$PORT, but not started by this ctl (no $PIDFILE)"
  else
    echo "server: not running"
    return 3
  fi
}

# --- relay ------------------------------------------------------------------------------------

node_major() { # node_major <node>: prints the major version, fails when it does not run
  local v
  v="$("$1" --version 2>/dev/null)" || return 1
  v="${v#v}"
  printf '%s' "${v%%.*}"
}

# The node binary for the relay: $RELAY_NODE, else `node` on the caller's PATH, else fnm's
# default alias (the boot command's PATH has neither). Must be >= RELAY_MIN_NODE.
relay_node() {
  local candidates=() c major
  if [[ -n "${RELAY_NODE:-}" ]]; then
    candidates=("$RELAY_NODE")
  else
    c="$(PATH="$CALLER_PATH" command -v node 2>/dev/null || true)"
    [[ -n "$c" ]] && candidates+=("$c")
    candidates+=("${FNM_DIR:-$HOME/.fnm}/aliases/default/bin/node" \
      "$HOME/.local/share/fnm/aliases/default/bin/node")
  fi
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] || continue
    major="$(node_major "$c")" || continue
    if [[ "$major" =~ ^[0-9]+$ ]] && ((major >= RELAY_MIN_NODE)); then
      printf '%s' "$c"
      return 0
    fi
  done
  return 1
}

# --- node processes (relay, narrate) ----------------------------------------------------------
# Both run `server.mjs` from their own subdir of $DIR; the helpers take <label> <subdir> <pidfile>.

# start_node <label> <subdir> <pidfile> <log> [VAR=value ...]: start $DIR/<subdir>/server.mjs
# detached with the given env. Never fails the ctl: the server is useful without the relay and
# the adapter, so a missing node or missing dependencies are reported and start goes on.
start_node() {
  local label="$1" sub="$2" pidfile="$3" log="$4" orphans node
  shift 4
  if alive "$pidfile" server.mjs "$DIR/$sub"; then
    echo "$label: already running (pid $(cat "$pidfile"))"
    return 0
  fi
  orphans="$(node_orphans "$sub")"
  if [[ -n "$orphans" ]]; then
    echo "$label: already running without a pid file (pid $(echo $orphans)), not starting another (run: $0 stop)"
    return 0
  fi
  if ! node="$(relay_node)"; then
    echo "$label: not started, no node >= $RELAY_MIN_NODE found (set RELAY_NODE=/path/to/node)" >&2
    return 0
  fi
  if [[ ! -d "$DIR/$sub/node_modules" ]]; then
    echo "$label: not started, dependencies missing (run: cd $DIR/$sub && npm install)" >&2
    return 0
  fi
  mkdir -p "$DIR/run" "$DIR/logs"
  cd "$DIR/$sub"
  # No wait for the process (or the server) to answer: the ctl returns at once, well within the
  # caller's time budget. `env` execs, so $! is the node pid.
  env "$@" setsid nohup "$node" server.mjs >>"$log" 2>&1 </dev/null &
  echo $! >"$pidfile"
  echo "$label: started (pid $!, $node), log: $log"
}

# stop_node <label> <subdir> <pidfile>: stops the pid file's process and any process of this DIR
# running the same script without one, so none is orphaned.
stop_node() {
  local label="$1" sub="$2" pidfile="$3" pids=() pid
  if alive "$pidfile" server.mjs "$DIR/$sub"; then pids+=("$(cat "$pidfile")"); fi
  for pid in $(node_orphans "$sub"); do
    [[ " ${pids[*]} " == *" $pid "* ]] || pids+=("$pid")
  done
  rm -f "$pidfile"
  if ((${#pids[@]} == 0)); then
    echo "$label: not running"
    return 0
  fi
  for pid in "${pids[@]}"; do kill_ours "$pid" server.mjs "$DIR/$sub"; done
  echo "$label: stopped (pid ${pids[*]})"
}

# probe_host <bind host>: the address to probe on: the bind address, or loopback when it binds
# every interface.
probe_host() {
  case "$1" in
    "" | 0.0.0.0 | :: | "[::]") printf '127.0.0.1' ;;
    *:*) local h="${1#[}"; printf '[%s]' "${h%]}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# node_status <label> <subdir> <pidfile> <host> <port> <hint when /health fails>
node_status() {
  local label="$1" sub="$2" pidfile="$3" host="$4" port="$5" hint="$6" pid orphans url
  url="http://$(probe_host "$host"):$port/health"
  if alive "$pidfile" server.mjs "$DIR/$sub"; then
    pid="$(cat "$pidfile")"
  else
    orphans="$(node_orphans "$sub")"
    if [[ -z "$orphans" ]]; then
      if http_ok "$url"; then
        echo "$label: answering on $host:$port, but not started by this ctl (no $pidfile)"
      else
        echo "$label: not running"
      fi
      return 0
    fi
    pid="$(echo $orphans) (no pid file; $0 stop stops it)"
  fi
  if http_ok "$url"; then
    echo "$label: running (pid $pid) on $host:$port, /health ok"
  else
    echo "$label: running (pid $pid) on $host:$port, /health not ok at $url ($hint)"
  fi
}

start_relay() {
  # The relay's /health reports 503 until the server is up.
  start_node relay relay "$RELAY_PIDFILE" "$RELAY_LOG" \
    RELAY_HOST="$RELAY_HOST" RELAY_PORT="$RELAY_PORT" \
    OMNIVOICE_URL="${OMNIVOICE_URL:-http://127.0.0.1:$PORT}"
  if ((${#RELAY_ENV_LOADED[@]})); then
    echo "relay: env from $RELAY_ENV_FILE: ${RELAY_ENV_LOADED[*]}"
  fi
}
stop_relay() { stop_node relay relay "$RELAY_PIDFILE"; }
relay_status() {
  node_status relay relay "$RELAY_PIDFILE" "$RELAY_HOST" "$RELAY_PORT" "server down?"
}

# --- narrate ----------------------------------------------------------------------------------
# The Narrate (Chrome) / Read Aloud (OpenAI-compatible) adapter: it talks to the relay, so it
# starts after it. Its own /health is always ok while it runs; /config needs the relay.

start_narrate() {
  # Something else (the old spike, a hand-started adapter) already holds the port.
  if ! alive "$NARRATE_PIDFILE" server.mjs "$DIR/narrate" 2>/dev/null &&
    [[ -z "$(node_orphans narrate)" ]] &&
    http_ok "http://$(probe_host "$NARRATE_HOST"):$NARRATE_PORT/health"; then
    echo "narrate: already answering on $NARRATE_HOST:$NARRATE_PORT (not started by this ctl), not starting another"
    return 0
  fi
  start_node narrate narrate "$NARRATE_PIDFILE" "$NARRATE_LOG" \
    HOST="$NARRATE_HOST" PORT="$NARRATE_PORT" \
    RELAY_URL="http://$(probe_host "$RELAY_HOST"):$RELAY_PORT"
}
stop_narrate() { stop_node narrate narrate "$NARRATE_PIDFILE"; }
narrate_status() {
  node_status narrate narrate "$NARRATE_PIDFILE" "$NARRATE_HOST" "$NARRATE_PORT" "starting?"
}

# serve_status <label> <port> <https port>: whether `tailscale serve` maps HTTPS <https port> to
# 127.0.0.1:<port> (set once by hand: `tailscale serve --bg --https=<https port> <port>`). Never
# 443: on SPOCK HTTPS 443 already serves the Pavilio panel.
serve_status() {
  local label="$1" json
  if ! command -v tailscale >/dev/null 2>&1; then
    echo "tailscale serve ($label): tailscale not installed"
    return 0
  fi
  if ! json="$(tailscale serve status --json 2>/dev/null)"; then
    echo "tailscale serve ($label): status unavailable (tailscaled not running?)"
    return 0
  fi
  python3 - "$label" "$2" "$3" "$json" <<'PY' || echo "tailscale serve ($label): could not parse status"
import json, sys
label, port, https, raw = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
cfg = json.loads(raw or "{}") or {}
target = f"127.0.0.1:{port}"
suffix = f":{https}"
found, other = None, []
for hostport, web in (cfg.get("Web") or {}).items():
    if not hostport.endswith(suffix):
        continue
    for path, h in (web.get("Handlers") or {}).items():
        proxy = (h or {}).get("Proxy") or ""
        # The relay serves plain HTTP: an https:// (or schemeless) upstream is a wrong mapping.
        if proxy.rstrip("/") in (f"http://{target}", f"http://localhost:{port}"):
            found = f"https://{hostport}{path}"
        elif proxy:
            other.append(f"{path} -> {proxy}")
if found:
    print(f"tailscale serve ({label}): https {https} -> {target} ({found})")
else:
    extra = f"; {https} serves {', '.join(other)}" if other else ""
    print(f"tailscale serve ({label}): https {https} does not map to {target} (run: tailscale serve --bg --https={https} {port}){extra}")
PY
}

# --- verbs ------------------------------------------------------------------------------------

start() {
  start_server
  start_relay
  start_narrate
}

stop() {
  stop_narrate
  stop_relay
  stop_server
}

# Exit code is the server's (0 healthy, 1 loading, 3 not running); relay, narrate and serve are
# reported.
status() {
  local rc=0
  server_status || rc=$?
  relay_status
  narrate_status
  serve_status relay "$RELAY_PORT" "$RELAY_SERVE_HTTPS_PORT"
  serve_status narrate "$NARRATE_PORT" "$NARRATE_SERVE_HTTPS_PORT"
  return "$rc"
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  log) tail -n 50 -f "$LOG" ;;
  relay-log) tail -n 50 -f "$RELAY_LOG" ;;
  narrate-log) tail -n 50 -f "$NARRATE_LOG" ;;
  *) echo "usage: $0 start|stop|restart|status|log|relay-log|narrate-log" >&2; exit 2 ;;
esac
