# Copy to relay.env (gitignored) next to omnivoicectl. The ctl reads it on every call, so these
# apply however it is started (a terminal, a boot hook, another program). KEY=VALUE per line;
# a variable already set in the calling environment wins over this file.

# Browser origins allowed to call the relay (comma list). The code default is the author's site
# (https://motyl.dev); set your own. The reader extension talks to the narrate adapter and needs
# no entry here.
RELAY_ALLOWED_ORIGINS=https://example.com,http://localhost:3000

# RELAY_PORT=8891
# RELAY_HOST=127.0.0.1
# Optional Tailscale: the tailnet HTTPS port `tailscale serve` maps to the relay (status only
# checks it). Pick a free port; a port already serving something else would be replaced.
# RELAY_SERVE_HTTPS_PORT=8443
# Absolute path to a node >= 22, for when the ctl runs with a minimal PATH (e.g. a boot hook
# without fnm/nvm); the narrate adapter runs on it too.
# RELAY_NODE=/path/to/node

# Narrate / Read Aloud adapter (narrate/), in front of the relay. The reader extension uses it.
# NARRATE_PORT=8892
# NARRATE_HOST=127.0.0.1
# Optional Tailscale: the tailnet HTTPS port `tailscale serve` maps to the adapter (status checks it).
# NARRATE_SERVE_HTTPS_PORT=8444
