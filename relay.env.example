# Copy to relay.env (gitignored) next to omnivoicectl. The ctl reads it on every call, so these
# apply however it is started (Pavilio panel, WSL boot command, a terminal). KEY=VALUE per line;
# a variable already set in the calling environment wins over this file.

# Browser origins allowed to call the relay (comma list).
RELAY_ALLOWED_ORIGINS=https://motyl.dev,http://localhost:3000

# RELAY_PORT=8891
# RELAY_HOST=127.0.0.1
# The tailnet HTTPS port `tailscale serve` maps to the relay (status checks it). Not 443 on SPOCK:
# 443 serves the Pavilio panel.
# RELAY_SERVE_HTTPS_PORT=8443
# Absolute path to a node >= 22 (the WSL boot command's PATH has no fnm); the narrate adapter
# runs on it too.
# RELAY_NODE=/root/.local/share/fnm/aliases/default/bin/node

# Narrate / Read Aloud adapter (narrate/), in front of the relay.
# NARRATE_PORT=8892
# NARRATE_HOST=127.0.0.1
# The tailnet HTTPS port `tailscale serve` maps to the adapter (status checks it).
# NARRATE_SERVE_HTTPS_PORT=8444
